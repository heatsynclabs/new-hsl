---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import BaseContainer from '../components/base/BaseContainer.astro';
import BaseButton from '../components/base/BaseButton.astro';
---

<Layout title="Register - HeatSync Labs">
  <div class="register-page">
    <BaseContainer>
      <div class="register-header">
        <h1 class="register-title">Class Registration</h1>
        <p class="register-subtitle">
          Fill out the form below to register for classes at HeatSync Labs.
        </p>
      </div>

      <div class="airtable-embed">
        <iframe
          class="airtable-embed__iframe"
          src="https://airtable.com/embed/shrTr15stAbuQvnPz?backgroundColor=purple"
          frameborder="0"
          width="100%"
          height="533"
          style="background: transparent; border: 1px solid #ccc;"
        ></iframe>
      </div>

      <div class="register-footer">
        <BaseButton
          variant="outline"
          href="/classes"
        >
          ← Back to Classes
        </BaseButton>
      </div>
    </BaseContainer>
  </div>
</Layout>

<style>
  .register-page {
    flex: 1;
    padding: var(--space-8) 0;
  }

  .register-header {
    text-align: center;
    margin-bottom: var(--space-8);
  }

  .register-title {
    font-size: clamp(34px, 6vw, 56px);
    font-weight: 400;
    margin-bottom: var(--space-4);
    color: var(--color-text-primary);
    font-family: var(--font-display);
    line-height: 1;
    text-shadow: none;
  }

  .register-subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-tertiary);
    font-family: var(--font-body);
    max-width: 600px;
    margin: 0 auto;
    line-height: var(--leading-relaxed);
  }

  .airtable-embed {
    background: var(--color-bg-secondary);
    border: var(--color-border-thick);
    overflow: hidden;
    margin-bottom: var(--space-8);
  }

  .airtable-embed__iframe {
    display: block;
    min-height: 700px;
  }

  .register-footer {
    text-align: center;
  }

  @media (max-width: 768px) {
    .register-page {
      padding: var(--space-4) 0;
    }

    .register-title {
      font-size: var(--text-5xl);
    }

    .register-subtitle {
      font-size: var(--text-base);
    }

    .airtable-embed__iframe {
      min-height: 600px;
    }
  }
</style>

