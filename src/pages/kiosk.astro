---
export const prerender = true;
import '../styles/tokens.css';
import '../styles/base.css';
import KioskDisplay from '../components/kiosk/KioskDisplay.vue';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" />
    <!-- Default kiosk theme is light; /kiosk/dark opens the dark "big board". -->
    <script is:inline>
      document.documentElement.setAttribute('data-theme', 'light');
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <title>Kiosk Calendar - HeatSync Labs</title>
  </head>
  <body>
    <KioskDisplay client:load />
  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
    height: 100%;
    background: var(--char);
    overflow: hidden;
  }
</style>
