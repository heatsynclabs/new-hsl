---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import PaymentMethodsSection from '../components/sections/PaymentMethodsSection.astro';
---

<Layout title="Ways to Pay HeatSync Labs">
  <PaymentMethodsSection />
</Layout>

<style is:global>
  /* Print-specific styles to ensure single-page layout */
  @media print {
    /* Remove browser headers/footers by using 0 margins */
    @page {
      size: letter;
      margin: 0;
    }

    /* Add padding to body instead to control content area */
    body {
      padding: 0.3in;
      padding-top: 0.2in;
      padding-bottom: 0.2in;
    }

    /* Hide header and footer for clean printout */
    .header,
    .footer {
      display: none !important;
    }

    /* Remove main padding for print */
    .main {
      padding: 0 !important;
    }

    /* Ensure the page fits on one sheet (compact mode only).
       The layout sizes off design tokens (fixed px), so compact print
       shrinks the tokens themselves to scale everything down at once. */
    html:not(.print-full-page) {
      font-size: 10.5px;
      --text-xs: 8.5px;
      --text-sm: 10px;
      --text-base: 11px;
      --text-lg: 12px;
      --text-xl: 13px;
      --text-2xl: 15px;
      --text-3xl: 17px;
      --text-4xl: 19px;
      --text-5xl: 22px;
      --text-6xl: 24px;
      --space-1: 2px;
      --space-2: 4px;
      --space-3: 6px;
      --space-4: 8px;
      --space-5: 9px;
      --space-6: 11px;
      --space-8: 13px;
      --space-10: 15px;
      --space-12: 16px;
    }

    /* thinner borders read better at small print scale */
    html:not(.print-full-page) .payment-card {
      border-width: 2px;
    }
    html:not(.print-full-page) .payment-card__qr img {
      width: 64px;
      height: 64px;
    }

    /* The app shell forces min-height:100vh; in compact print that plus padding
       spills ~20px onto a 2nd sheet. Collapse those heights so the content
       (only ~700px) sits on one page. */
    body:not(.print-full-page),
    body:not(.print-full-page) #app,
    body:not(.print-full-page) .main {
      min-height: 0 !important;
      height: auto !important;
      overflow: visible !important;
    }

    /* Full page mode overrides */
    body.print-full-page,
    body.print-full-page * {
      overflow: visible !important;
      height: auto !important;
    }

    /* Remove background textures */
    body::before,
    body::after {
      display: none !important;
    }

    /* Hide Check card and footer */
    .payment-grid > *:last-child,
    .payment-section__footer {
      display: none !important;
    }
  }
</style>
