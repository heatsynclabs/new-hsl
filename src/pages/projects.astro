---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import BaseContainer from '../components/base/BaseContainer.astro';
import { marked } from 'marked';

const readmeUrl = 'https://raw.githubusercontent.com/heatsynclabs/awesome-heatsync/refs/heads/main/README.md';
const response = await fetch(readmeUrl);
const markdown = await response.text();
const htmlContent = await marked.parse(markdown);
---

<Layout title="Projects - HeatSync Labs">
  <BaseContainer>
    <article class="content-page">
      <header class="content-header">
        <h1 class="content-title">Projects</h1>
        <p class="content-description">Awesome projects from the HeatSync Labs community</p>
      </header>
      <div class="content-body" set:html={htmlContent} />
    </article>
  </BaseContainer>
</Layout>

<style>
  .content-page {
    padding: var(--space-8) 0;
  }

  .content-header {
    margin-bottom: var(--space-8);
  }

  .content-title {
    font-size: clamp(34px, 6vw, 56px);
    font-weight: 400;
    margin-bottom: var(--space-4);
    color: var(--color-text-primary);
    font-family: var(--font-display);
    text-align: center;
    line-height: 1;
    text-shadow: none;
  }

  .content-description {
    font-size: var(--text-lg);
    color: var(--color-text-tertiary);
    font-family: var(--font-body);
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
    line-height: var(--leading-relaxed);
  }

  .content-body {
    max-width: 800px;
    margin: 0 auto;
  }

  .content-body :global(h1) {
    display: none; /* Hide the README's h1 since we have our own title */
  }

  .content-body :global(h2) {
    font-size: var(--text-3xl);
    font-weight: 400;
    margin-top: var(--space-10);
    margin-bottom: var(--space-4);
    color: var(--color-text-primary);
    font-family: var(--font-display);
    border-bottom: 3px solid var(--color-accent-primary);
    padding-bottom: var(--space-2);
    line-height: 1;
  }

  .content-body :global(h3) {
    font-size: var(--text-xl);
    font-weight: 400;
    margin-top: var(--space-6);
    margin-bottom: var(--space-3);
    color: var(--color-accent-secondary);
    font-family: var(--font-ui);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
  }

  .content-body :global(h4) {
    font-size: var(--text-lg);
    font-weight: 400;
    margin-top: var(--space-4);
    margin-bottom: var(--space-2);
    color: var(--color-accent-secondary);
    font-family: var(--font-ui);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .content-body :global(p) {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-4);
    color: var(--color-text-secondary);
    font-family: var(--font-body);
  }

  .content-body :global(ul),
  .content-body :global(ol) {
    margin-bottom: var(--space-4);
    padding-left: var(--space-6);
  }

  .content-body :global(li) {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-2);
    color: var(--color-text-secondary);
    font-family: var(--font-sans);
  }

  .content-body :global(a) {
    color: var(--color-accent-secondary);
    text-decoration: underline;
    text-underline-offset: 2px;
    font-weight: var(--font-bold);
    transition: color var(--transition-base);
  }
  :global([data-theme="dark"]) .content-body :global(a) { color: var(--orange); }

  .content-body :global(a:hover) {
    color: var(--color-text-primary);
  }

  .content-body :global(strong) {
    font-weight: var(--font-semibold);
    color: var(--color-text-primary);
  }

  .content-body :global(em) {
    font-style: italic;
  }

  .content-body :global(code) {
    background: var(--color-bg-secondary);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .content-body :global(pre) {
    background: var(--color-bg-secondary);
    padding: var(--space-4);
    border-radius: var(--radius-base);
    overflow-x: auto;
    margin-bottom: var(--space-4);
  }

  .content-body :global(pre code) {
    background: transparent;
    padding: 0;
  }

  .content-body :global(blockquote) {
    border-left: 4px solid var(--color-accent-primary);
    padding-left: var(--space-4);
    margin: var(--space-4) 0;
    color: var(--color-text-tertiary);
    font-style: italic;
  }

  .content-body :global(hr) {
    border: none;
    border-top: 2px solid var(--color-border);
    margin: var(--space-8) 0;
  }

  .content-body :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-base);
  }

  .content-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: var(--space-4) 0;
  }

  .content-body :global(th),
  .content-body :global(td) {
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border);
  }

  .content-body :global(th) {
    background: var(--color-bg-secondary);
    font-weight: var(--font-medium);
  }

  @media (max-width: 768px) {
    .content-page {
      padding: var(--space-4) 0;
    }

    .content-title {
      font-size: var(--text-3xl);
    }

    .content-description {
      font-size: var(--text-base);
    }

    .content-body :global(h2) {
      font-size: var(--text-xl);
      margin-top: var(--space-6);
    }
  }
</style>
