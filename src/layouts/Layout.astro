---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/utilities.css';
import AppHeader from '../components/layout/AppHeader.astro';
import AppFooter from '../components/layout/AppFooter.astro';

interface Props {
  title?: string;
}

const { title = 'HeatSync Labs' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="HeatSync Labs - Arizona's Community Hackerspace" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.ico" />

    <!-- Theme detection (runs before CSS to prevent flash) -->
    <script is:inline>
      (function() {
        // Default to light on first visit; only an explicit toggle changes it.
        const stored = localStorage.getItem('theme-preference');
        const theme = stored === 'dark' || stored === 'light' ? stored : 'light';
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
    <meta name="generator" content={Astro.generator} />

    <!-- Fonts are imported in tokens.css (Permanent Marker / Instrument Sans / Space Mono / Courier Prime / Charis SIL) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <title>{title}</title>
  </head>
  <body>
    <div id="app">
      <AppHeader />
      <main class="main">
        <slot />
      </main>
      <AppFooter />
    </div>
  </body>
</html>

<style>
  html {
    font-family: var(--font-body);
    transition: background-color var(--transition-base), color var(--transition-base);
  }

  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background-color: var(--color-bg-primary);
    color: var(--color-text-primary);
    line-height: 1.62;
    position: relative;
    transition: background-color var(--transition-base), color var(--transition-base);
  }

  /* Paper grain - layered radial-gradient noise (design system body texture) */
  body::before {
    content: '';
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 1;
    z-index: -1;
    background-image:
      radial-gradient(rgba(0,0,0,0.025) 1px, transparent 1px),
      radial-gradient(rgba(0,0,0,0.02) 1px, transparent 1px);
    background-size: 3px 3px, 7px 7px;
    background-position: 0 0, 1px 2px;
    pointer-events: none;
    transition: opacity var(--transition-base);
  }

  /* Paper grain - dark mode (lighter speckle on ink) */
  :global([data-theme="dark"]) body::before {
    background-image:
      radial-gradient(rgba(255,255,255,0.03) 1px, transparent 1px),
      radial-gradient(rgba(255,255,255,0.02) 1px, transparent 1px);
    background-size: 3px 3px, 7px 7px;
    background-position: 0 0, 1px 2px;
    opacity: 1;
  }

  #app {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    position: relative;
    z-index: 0;
  }

  .main {
    flex: 1;
  }
</style>