---
import BaseContainer from '../base/BaseContainer.astro';
import BaseButton from '../base/BaseButton.astro';
import PhotoCarousel from '../graphics/PhotoCarousel.vue';
---

<section class="hero">
  <BaseContainer>
    <div class="hero__wrapper">
      <div class="hero__content">
        <!-- Location row (status indicator lives in the caution ribbon above) -->
        <div class="hero__meta">
          <a href="https://maps.app.goo.gl/Qh3wZuQuik4U7niE6" target="_blank" rel="noopener" class="hero__location">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
            Mesa, AZ
          </a>
        </div>

        <h1 class="hero__headline">
          Arizona's <span class="hero__accent">original</span> hackerspace, built on open source principles.
        </h1>

        <p class="hero__body">
          We are a <a href="https://medlabboulder.gitlab.io/democraticmediums/mediums/do-ocracy/" target="_blank" rel="noopener" class="hero__doo">do-ocracy</a>. Show up, contribute, learn, and build alongside a diverse and inclusive maker community that supports each other.
        </p>

        <a href="/about" class="hero__welcome">
          Everyone is welcome
          <svg class="heart-icon" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        </a>

        <div class="hero__actions">
          <BaseButton variant="primary" size="md" href="/community">
            Join the Community
          </BaseButton>
          <BaseButton variant="secondary" size="md" href="/about#visit-us">
            Visit Us
          </BaseButton>
        </div>

        <div class="stats-row">
          <div class="stat">
            <div class="stat-value">16+</div>
            <div class="stat-label">Years Running</div>
          </div>
          <div class="stat">
            <div class="stat-value">100+</div>
            <div class="stat-label">Active Members</div>
          </div>
          <div class="stat">
            <div class="stat-value">6,811</div>
            <div class="stat-label">Total Events</div>
          </div>
          <div class="stat">
            <div class="stat-value">25,177</div>
            <div class="stat-label">Hours Open</div>
          </div>
        </div>
      </div>

      <!-- Photo carousel (design-system framed) -->
      <div class="carousel-wrapper">
        <PhotoCarousel client:load />
      </div>
    </div>
  </BaseContainer>
</section>


<style>
  .hero {
    padding: 64px 0 52px;
    position: relative;
    background: var(--color-bg-primary);
    transition: background-color var(--transition-base);
  }

  .hero__wrapper {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    align-items: start;
    gap: 46px;
  }

  .hero__content {
    position: relative;
    z-index: var(--z-raised);
  }

  /* Status + location row */
  .hero__meta {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }

  .hero__location {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-ui);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--smoke);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .hero__location:hover {
    color: var(--accent-text);
  }

  .hero__location svg {
    width: 12px;
    height: 12px;
  }

  .hero__headline {
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: none;
    font-size: clamp(34px, 5vw, 58px);
    line-height: 1.02;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    margin: 0 0 20px;
    max-width: 16ch;
  }

  .hero__accent {
    color: var(--accent-text);
  }

  .hero__body {
    font-family: var(--font-body);
    font-size: 17px;
    line-height: var(--leading-relaxed);
    color: var(--ash);
    max-width: 50ch;
    margin: 0 0 18px;
  }

  .hero__doo {
    color: var(--accent-text);
    font-weight: 600;
    border-bottom: 2px solid var(--hazard);
  }

  .hero__welcome {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-bottom: 26px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 18px;
    color: var(--accent-text);
    border-bottom: 2px solid var(--hazard);
    padding-bottom: 2px;
    text-decoration: none;
  }

  .heart-icon {
    width: 16px;
    height: 16px;
    display: inline-block;
    vertical-align: middle;
    color: var(--rust);
    animation: hsl-rainbow-heart 4.2s linear infinite;
  }

  .hero__actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 26px;
  }

  /* Stats row */
  .stats-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    border-top: var(--bd-2);
    margin-top: 34px;
  }

  .stat {
    padding: 22px 18px;
    border-right: var(--bd);
  }

  .stat:last-child {
    border-right: 0;
  }

  .stat-value {
    font-family: var(--font-display);
    font-size: 34px;
    font-weight: 800;
    color: var(--accent-text);
    line-height: 1;
  }

  .stat-label {
    font-family: var(--font-ui);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--smoke);
    font-weight: 500;
    margin-top: 8px;
  }

  /* Carousel wrapper */
  .carousel-wrapper {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: center;
  }

  /* Responsive */
  @media (max-width: 880px) {
    .hero__wrapper {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .hero__content {
      order: 2;
    }

    .carousel-wrapper {
      order: 1;
    }

    .stats-row {
      grid-template-columns: repeat(2, 1fr);
    }

    .stat:nth-child(2) {
      border-right: 0;
    }

    .stat:nth-child(-n+2) {
      border-bottom: var(--bd);
    }
  }

  @media (max-width: 600px) {
    .hero {
      padding: 40px 0 36px;
    }

    .stat-value {
      font-size: 28px;
    }
  }
</style>