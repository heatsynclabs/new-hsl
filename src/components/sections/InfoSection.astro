---
import BaseContainer from '../base/BaseContainer.astro';

const infoItems = [
  {
    title: 'Open Workshop',
    description: '3,200 square feet of workspace equipped with 3D printers, laser cutters, electronics workbenches, and traditional tools for woodworking and metalworking.',
  },
  {
    title: 'Community Driven',
    description: 'Member-owned and operated since 2009. We\'re a 501(c)3 non-profit dedicated to fostering creativity and technical education.',
  },
  {
    title: 'Learn & Share',
    description: 'Regular workshops, hackathons, and skill-sharing sessions. From Arduino basics to advanced fabrication techniques, there\'s always something new.',
  },
];
---

<section class="info-section">
  <BaseContainer>
    <div class="info-section__head">
      <span class="info-section__num">02</span>
      <span class="eyebrow">Who we are</span>
    </div>
    <h2 class="info-section__title sec-title">About Us</h2>
    <div class="rules-row">
      {infoItems.map((item, i) => (
        <div class:list={['rule-card', { 'rule-card--feature': i === 1 }]}>
          <span class="rule-card__num">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="rule-card__title">{item.title}</h3>
          <p class="rule-card__desc">{item.description}</p>
        </div>
      ))}
    </div>
  </BaseContainer>
</section>

<style>
  .info-section {
    padding: 60px 0;
    border-top: 2px solid var(--steel-hi);
  }

  .info-section__head {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin-bottom: 6px;
    flex-wrap: wrap;
  }

  .info-section__num {
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 13px;
    color: var(--accent-text);
  }

  .info-section__title {
    margin-bottom: 36px;
    font-size: clamp(36px, 6vw, 64px);
  }

  /* About cards — 3-up, feature variant on middle */
  .rules-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 26px;
  }

  .rule-card {
    position: relative;
    background: var(--slab);
    border: var(--bd);
    box-shadow: var(--shadow);
    padding: 32px 26px;
  }

  .rule-card--feature {
    background: var(--char);
    border-color: var(--hazard);
    border-left: 3px solid var(--hazard);
  }

  .rule-card__num {
    position: absolute;
    top: -14px;
    left: 20px;
    background: var(--hazard);
    color: var(--tape-dark);
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.1em;
    padding: 4px 9px;
  }

  .rule-card__title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 24px;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    color: var(--accent-text);
    margin: 12px 0 14px;
    line-height: 1.05;
  }

  .rule-card__desc {
    font-family: var(--font-body);
    font-size: 15px;
    line-height: var(--leading-relaxed);
    color: var(--ash);
  }

  @media (max-width: 820px) {
    .info-section { padding: 48px 0; }
    .rules-row { grid-template-columns: 1fr; gap: 22px; }
  }
</style>
