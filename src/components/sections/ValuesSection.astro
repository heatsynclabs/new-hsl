---
import BaseContainer from '../base/BaseContainer.astro';

const values = [
  {
    title: 'Be excellent to each other.',
    body: "That's it. That's the whole thing. Everything else follows from here.",
  },
  {
    title: 'Do-ocracy.',
    body: 'If you want something done, do it. Do not wait for permission or committees. When you are unsure or something is irreversible, seek consensus first.',
  },
  {
    title: 'Leave it better.',
    body: 'The space. The tools. The community. Better than you found it, every time.',
  },
  {
    title: 'Teach and learn.',
    body: 'Teach what you know. Ask about what you do not.',
  },
  {
    title: "We're a Community, Not a Service",
    body: 'Membership is a donation to a community, not a subscription to a service.',
  },
];
---

<section class="values">
  <BaseContainer>
    <div class="values__head">
      <span class="values__num">03</span>
      <span class="eyebrow">How we operate</span>
    </div>
    <h2 class="values__title sec-title">Our Values</h2>

    <ul class="values__list">
      {values.map((v) => (
        <li class="value-row">
          <h4 class="value-row__title">{v.title}</h4>
          <p class="value-row__body">{v.body}</p>
        </li>
      ))}
    </ul>
  </BaseContainer>
</section>

<style>
  .values {
    padding: 60px 0;
    border-top: 2px solid var(--steel-hi);
  }

  .values__head {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin-bottom: 6px;
    flex-wrap: wrap;
  }

  .values__num {
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 13px;
    color: var(--accent-text);
  }

  .values__title {
    margin-bottom: 34px;
    font-size: clamp(36px, 6vw, 64px);
  }

  .values__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  /* Each value is a colored bar — left-border accent + faint gradient tint.
     Color is decorative; the title carries the meaning. */
  .value-row {
    --vc: var(--hazard);
    border: var(--bd);
    border-left: 4px solid var(--vc);
    background: linear-gradient(90deg, color-mix(in srgb, var(--vc) 16%, transparent), transparent 55%);
    padding: 18px 22px;
  }

  .value-row:nth-child(1) { --vc: var(--hazard); }
  .value-row:nth-child(2) { --vc: var(--violet); }
  .value-row:nth-child(3) { --vc: var(--live); }
  .value-row:nth-child(4) { --vc: var(--fault); }
  .value-row:nth-child(5) { --vc: var(--info); }

  .value-row__title {
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 15px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--vc);
    margin: 0 0 6px;
  }

  .value-row__body {
    font-family: var(--font-body);
    font-size: 15px;
    line-height: var(--leading-relaxed);
    color: var(--ash);
    margin: 0;
  }

  @media (max-width: 820px) {
    .values { padding: 48px 0; }
  }
</style>
