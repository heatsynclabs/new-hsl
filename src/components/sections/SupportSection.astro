---
import BaseContainer from '../base/BaseContainer.astro';
import StyledDonateButton from '../base/StyledDonateButton.vue';
---

<section class="support-banner">
  <div class="support-banner__bg"></div>
  <BaseContainer>
    <div class="support-banner__content">
      <div class="support-banner__text">
        <div class="eyebrow support-banner__eyebrow">// 501(c)(3) Nonprofit // Est. 2009</div>
        <h2 class="support-banner__title">Help Us Keep the Doors Open <svg class="heart-icon" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg></h2>
        <p class="support-banner__desc">
          HeatSync Labs is 100% volunteer-run and funded by people like you. Your donation keeps the tools running and the space accessible to everyone.
        </p>
      </div>
      <div class="support-banner__action">
        <StyledDonateButton client:load />
      </div>
    </div>
  </BaseContainer>
</section>

<style>
  .support-banner {
    position: relative;
    background: var(--char);
    border-top: 2px solid var(--steel-hi);
    overflow: hidden;
  }

  .support-banner__bg {
    display: none;
  }

  .support-banner__content {
    position: relative;
    padding: 64px 0;
    display: grid;
    grid-template-columns: 1.3fr auto;
    gap: 40px;
    align-items: center;
  }

  .support-banner__text {
    max-width: 620px;
  }

  .support-banner__eyebrow {
    margin-bottom: 16px;
  }

  .support-banner__title {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(32px, 4.4vw, 50px);
    line-height: 1;
    color: var(--color-text-primary);
    margin: 0 0 18px;
    letter-spacing: -0.01em;
    text-transform: none;
  }

  .support-banner__title .heart-icon {
    width: 30px;
    height: 30px;
    display: inline-block;
    vertical-align: middle;
    color: var(--rust);
    animation: hsl-rainbow-heart 4.2s linear infinite;
  }

  .support-banner__desc {
    font-family: var(--font-body);
    font-size: 17px;
    line-height: var(--leading-relaxed);
    color: var(--ash);
    margin: 0;
    max-width: 48ch;
  }

  .support-banner__action {
    flex-shrink: 0;
  }

  @media (max-width: 820px) {
    .support-banner__content {
      grid-template-columns: 1fr;
      gap: 24px;
      padding: 48px 0;
    }
  }
</style>
