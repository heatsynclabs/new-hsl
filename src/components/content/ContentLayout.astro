---
import BaseContainer from '../base/BaseContainer.astro';
import { getEntry } from 'astro:content';

interface Props {
  contentEntry: Awaited<ReturnType<typeof getEntry>>;
}

const { contentEntry } = Astro.props;

const { Content } = await contentEntry.render();
const frontmatter = contentEntry.data;
---

<BaseContainer>
  <article class="content-page">
    <header class="content-header">
      <h1 class="content-title">{frontmatter.title}</h1>
      {frontmatter.description && (
        <p class="content-description">{frontmatter.description}</p>
      )}
    </header>
    <div class="content-body">
      <Content />
    </div>
  </article>
</BaseContainer>

<style>
  .content-page {
    padding: var(--space-8) 0;
  }

  .content-header {
    margin-bottom: var(--space-8);
  }

  .content-title {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(34px, 6vw, 56px);
    line-height: 1;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-4);
    color: var(--color-text-primary);
    text-align: left;
    text-transform: none;
  }

  .content-description {
    font-size: 19px;
    color: var(--ash);
    font-family: var(--font-body);
    text-align: left;
    max-width: 640px;
    margin: 0;
    line-height: var(--leading-relaxed);
  }

  .content-body {
    max-width: 800px;
    margin: 0 auto;
  }

  .content-body :global(h2) {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(26px, 3.4vw, 34px);
    text-transform: uppercase;
    letter-spacing: -0.01em;
    margin-top: var(--space-10);
    margin-bottom: var(--space-4);
    color: var(--color-text-primary);
    border-bottom: 2px solid var(--hazard);
    padding-bottom: var(--space-2);
    line-height: 1;
  }

  .content-body :global(h3) {
    font-size: 22px;
    font-weight: 800;
    margin-top: var(--space-6);
    margin-bottom: var(--space-3);
    color: var(--accent-text);
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: -0.005em;
  }

  .content-body :global(h4) {
    font-size: 13px;
    font-weight: 600;
    margin-top: var(--space-4);
    margin-bottom: var(--space-2);
    color: var(--accent-text);
    font-family: var(--font-ui);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .content-body :global(p) {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-4);
    color: var(--color-text-secondary);
    font-family: var(--font-body);
  }

  .content-body :global(ul),
  .content-body :global(ol) {
    margin-bottom: var(--space-4);
    padding-left: var(--space-6);
  }

  .content-body :global(li) {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-2);
    color: var(--color-text-secondary);
    font-family: var(--font-body);
  }

  .content-body :global(ul li) {
    position: relative;
    padding-left: var(--space-5);
  }

  .content-body :global(ul li)::before {
    content: '+';
    position: absolute;
    left: 0;
    color: var(--accent-text);
    font-family: var(--font-ui);
    font-size: 17px;
    font-weight: 700;
    line-height: 1;
  }

  .content-body :global(a) {
    color: var(--accent-text);
    text-decoration: none;
    border-bottom: 2px solid var(--hazard);
    font-weight: 600;
    transition: color var(--transition-fast);
  }

  .content-body :global(a:hover) {
    color: var(--color-text-primary);
    border-bottom-color: var(--color-text-primary);
  }

  .content-body :global(strong) {
    font-weight: var(--font-semibold);
    color: var(--color-text-primary);
  }

  .content-body :global(em) {
    font-style: italic;
  }

  .content-body :global(code) {
    background: var(--color-bg-secondary);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .content-body :global(pre) {
    background: var(--color-bg-secondary);
    padding: var(--space-4);
    border-radius: var(--radius-base);
    overflow-x: auto;
    margin-bottom: var(--space-4);
  }

  .content-body :global(pre code) {
    background: transparent;
    padding: 0;
  }

  .content-body :global(.donate-cta) {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--hazard);
    color: var(--tape-dark);
    padding: 14px 24px;
    border: 2px solid var(--tape-dark);
    font-family: var(--font-ui);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition: transform 0.1s ease, box-shadow 0.1s ease;
    margin: var(--space-2) 0 var(--space-4);
  }

  .content-body :global(.donate-cta:hover) {
    transform: translate(-2px, -2px);
    box-shadow: var(--shadow);
    color: var(--tape-dark);
    border-bottom-color: var(--tape-dark);
  }

  .content-body :global(blockquote) {
    border-left: 4px solid var(--color-accent-primary);
    padding-left: var(--space-4);
    margin: var(--space-4) 0;
    color: var(--color-text-tertiary);
    font-style: italic;
  }

  .content-body :global(hr) {
    border: none;
    border-top: 2px solid var(--color-border);
    margin: var(--space-8) 0;
  }

  .content-body :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-base);
  }

  .content-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: var(--space-4) 0;
  }

  .content-body :global(th),
  .content-body :global(td) {
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border);
  }

  .content-body :global(th) {
    background: var(--color-bg-secondary);
    font-weight: var(--font-medium);
  }

  @media (max-width: 768px) {
    .content-page {
      padding: var(--space-4) 0;
    }

    .content-title {
      font-size: var(--text-3xl);
    }

    .content-description {
      font-size: var(--text-base);
    }

    .content-body :global(h2) {
      font-size: var(--text-xl);
      margin-top: var(--space-6);
    }
  }
</style>
