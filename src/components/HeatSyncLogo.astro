---
interface Props {
  size?: 'sm' | 'md' | 'lg'
  showText?: boolean
  interactive?: boolean
}

const { size = 'md', showText = true, interactive = true } = Astro.props;
const logoClasses = [
  'logo',
  `logo--${size}`,
  interactive && 'logo--interactive',
  !showText && 'logo--text-only',
].filter(Boolean).join(' ');
---

<div class={logoClasses}>
  <img src="/hsl-logo.png" alt="HeatSync Labs" class="logo__mark logo__mark--light" />
  <img src="/hsl-logo-dark.png" alt="" aria-hidden="true" class="logo__mark logo__mark--dark" />
  {showText && <span class="logo__text">HeatSync Labs</span>}
</div>

<style>

  .logo {
    display: flex;
    align-items: center;
    gap: 11px;
    font-family: var(--font-logo);
    font-weight: 700;
    letter-spacing: 0;
    color: var(--color-text-primary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .logo__mark {
    flex-shrink: 0;
    object-fit: contain;
  }

  /* Dark-mode logo variant: black flame/arrow recolored to paper, orange kept */
  .logo__mark--dark { display: none; }
  :global([data-theme="dark"]) .logo__mark--light { display: none; }
  :global([data-theme="dark"]) .logo__mark--dark { display: block; }

  .logo__text {
    white-space: nowrap;
    /* Brand wordmark keeps Charis SIL — the brand mark, not a design-system font */
    font-family: var(--font-logo);
    font-weight: 700;
    letter-spacing: 0;
    text-transform: none;
  }

  /* Sizes */
  .logo--sm .logo__mark {
    width: 26px;
    height: 26px;
  }

  .logo--sm .logo__text {
    font-size: 17px;
  }

  .logo--md .logo__mark {
    width: 34px;
    height: 34px;
  }

  .logo--md .logo__text {
    font-size: 23px;
  }

  @media (max-width: 640px) {
    .logo--md .logo__text {
      font-size: 18px;
    }
    .logo--md .logo__mark {
      width: 30px;
      height: 30px;
    }
  }

  .logo--lg .logo__mark {
    width: 48px;
    height: 48px;
  }

  .logo--lg .logo__text {
    font-size: 30px;
  }

  /* Interactive state - no spin; quiet wordmark tint only */
  .logo--interactive:hover .logo__text {
    color: var(--color-accent-secondary);
  }

  /* Text-only variant */
  .logo--text-only {
    gap: 0;
  }

  .logo--text-only .logo__mark {
    display: none;
  }
</style>

