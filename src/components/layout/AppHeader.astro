---
import BaseContainer from '../base/BaseContainer.astro';
import HeatSyncLogo from '../HeatSyncLogo.astro';
import ThemeToggle from './ThemeToggle.vue';
---

<header class="header">
  <BaseContainer>
    <nav class="nav">
      <div class="nav__logo-group">
        <a href="/" class="nav__logo">
          <HeatSyncLogo />
        </a>
      </div>

      <ul class="nav__links">
        <li><a href="/about" class="nav__link">About</a></li>
        <li><a href="/membership" class="nav__link">Membership</a></li>
        <li><a href="/calendar" class="nav__link">Events</a></li>
        <li><a href="https://www.flickr.com/people/hslphotosync/" class="nav__link" target="_blank" rel="noopener">Projects</a></li>
        <li><a href="https://wiki.heatsynclabs.org" class="nav__link" target="_blank" rel="noopener">Wiki</a></li>
        <li><a href="/classes" class="nav__link">Classes</a></li>
        <li class="nav__dropdown">
          <a href="/support" class="nav__link">
            Support Us
            <svg width="10" height="6" viewBox="0 0 10 6" fill="currentColor" class="nav__dropdown-icon">
              <path d="M5 6L0 0h10L5 6z"/>
            </svg>
          </a>
          <ul class="nav__dropdown-menu">
            <li><a href="/pay" class="nav__dropdown-link">Ways to Pay HSL</a></li>
          </ul>
        </li>
        <li class="nav__divider"></li>
        <li>
          <a href="https://discord.gg/2aWPgkeS6Q" class="nav__link nav__link--icon" target="_blank" rel="noopener" aria-label="Join our Discord">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
              <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515a.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0a12.64 12.64 0 0 0-.617-1.25a.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057a19.9 19.9 0 0 0 5.993 3.03a.078.078 0 0 0 .084-.028a14.09 14.09 0 0 0 1.226-1.994a.076.076 0 0 0-.041-.106a13.107 13.107 0 0 1-1.872-.892a.077.077 0 0 1-.008-.128a10.2 10.2 0 0 0 .372-.292a.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127a12.299 12.299 0 0 1-1.873.892a.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028a19.839 19.839 0 0 0 6.002-3.03a.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419c0-1.333.956-2.419 2.157-2.419c1.21 0 2.176 1.096 2.157 2.42c0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419c0-1.333.955-2.419 2.157-2.419c1.21 0 2.176 1.096 2.157 2.42c0 1.333-.946 2.418-2.157 2.418z"/>
            </svg>
          </a>
        </li>
        <li>
          <a href="http://bit.ly/hslslack" class="nav__link nav__link--icon" target="_blank" rel="noopener" aria-label="Join our Slack">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
              <path d="M5.042 15.165a2.528 2.528 0 0 1-2.52 2.523A2.528 2.528 0 0 1 0 15.165a2.527 2.527 0 0 1 2.522-2.52h2.52v2.52zM6.313 15.165a2.527 2.527 0 0 1 2.521-2.52 2.527 2.527 0 0 1 2.521 2.52v6.313A2.528 2.528 0 0 1 8.834 24a2.528 2.528 0 0 1-2.521-2.522v-6.313zM8.834 5.042a2.528 2.528 0 0 1-2.521-2.52A2.528 2.528 0 0 1 8.834 0a2.528 2.528 0 0 1 2.521 2.522v2.52H8.834zM8.834 6.313a2.528 2.528 0 0 1 2.521 2.521 2.528 2.528 0 0 1-2.521 2.521H2.522A2.528 2.528 0 0 1 0 8.834a2.528 2.528 0 0 1 2.522-2.521h6.312zM18.956 8.834a2.528 2.528 0 0 1 2.522-2.521A2.528 2.528 0 0 1 24 8.834a2.528 2.528 0 0 1-2.522 2.521h-2.522V8.834zM17.688 8.834a2.528 2.528 0 0 1-2.523 2.521 2.527 2.527 0 0 1-2.52-2.521V2.522A2.527 2.527 0 0 1 15.165 0a2.528 2.528 0 0 1 2.523 2.522v6.312zM15.165 18.956a2.528 2.528 0 0 1 2.523 2.522A2.528 2.528 0 0 1 15.165 24a2.527 2.527 0 0 1-2.52-2.522v-2.522h2.52zM15.165 17.688a2.527 2.527 0 0 1-2.52-2.523 2.526 2.526 0 0 1 2.52-2.52h6.313A2.527 2.527 0 0 1 24 15.165a2.528 2.528 0 0 1-2.522 2.523h-6.313z"/>
            </svg>
          </a>
        </li>
        <li>
          <a href="https://www.instagram.com/heatsynclabs/" class="nav__link nav__link--icon" target="_blank" rel="noopener" aria-label="Follow us on Instagram">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zM5.838 12a6.162 6.162 0 1 1 12.324 0 6.162 6.162 0 0 1-12.324 0zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm4.965-10.405a1.44 1.44 0 1 1 2.881.001 1.44 1.44 0 0 1-2.881-.001z"/>
            </svg>
          </a>
        </li>
        <li>
          <ThemeToggle client:load />
        </li>
      </ul>

      <button
        class="nav__mobile-toggle"
        id="mobile-toggle"
        aria-expanded="false"
        aria-label="Toggle navigation menu"
      >
        <span class="nav__mobile-toggle-line"></span>
        <span class="nav__mobile-toggle-line"></span>
        <span class="nav__mobile-toggle-line"></span>
      </button>
    </nav>

    <!-- Mobile Menu -->
    <div class="nav__mobile-menu" id="mobile-menu">
      <ul class="nav__mobile-links">
        <li><a href="/about" class="nav__mobile-link">About</a></li>
        <li><a href="/membership" class="nav__mobile-link">Membership</a></li>
        <li><a href="/calendar" class="nav__mobile-link">Events</a></li>
        <li><a href="https://www.flickr.com/people/hslphotosync/" class="nav__mobile-link" target="_blank" rel="noopener">Projects</a></li>
        <li><a href="https://wiki.heatsynclabs.org" class="nav__mobile-link" target="_blank" rel="noopener">Wiki</a></li>
        <li><a href="/classes" class="nav__mobile-link">Classes</a></li>
        <li><a href="/support" class="nav__mobile-link">Support Us</a></li>
        <li><a href="/pay" class="nav__mobile-link nav__mobile-link--sub">Ways to Pay HSL</a></li>
      </ul>
    </div>
  </BaseContainer>
</header>

<script>
  const toggle = document.getElementById('mobile-toggle');
  const menu = document.getElementById('mobile-menu');

  if (toggle && menu) {
    // Initialize menu as hidden
    menu.style.display = 'none';

    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!isOpen));
      menu.style.display = isOpen ? 'none' : 'block';
    });

    // Close menu when clicking a link
    const links = menu.querySelectorAll('.nav__mobile-link');
    links.forEach(link => {
      link.addEventListener('click', () => {
        toggle.setAttribute('aria-expanded', 'false');
        menu.style.display = 'none';
      });
    });

    // Close menu when clicking outside
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (!toggle.contains(target) && !menu.contains(target)) {
        if (toggle.getAttribute('aria-expanded') === 'true') {
          toggle.setAttribute('aria-expanded', 'false');
          menu.style.display = 'none';
        }
      }
    });
  }
</script>

<style>
  .header {
    background: var(--color-bg-secondary);
    border-bottom: 1px solid var(--color-border);
    box-shadow: 0 1px 4px var(--color-shadow);
    position: sticky;
    top: 0;
    z-index: var(--z-overlay);
    transition: background-color var(--transition-base), border-color var(--transition-base);
  }

  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: var(--header-height);
    gap: var(--space-6);
  }

  .nav__logo-group {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .nav__logo {
    text-decoration: none;
    color: inherit;
  }

  .nav__links {
    display: flex;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
    justify-self: end;
    align-items: center;
    flex-wrap: nowrap;
  }

  .nav__link {
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    letter-spacing: var(--tracking-wide);
    transition: color var(--transition-base);
    position: relative;
    padding: var(--space-2) 0;
    white-space: nowrap;
  }

  .nav__link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--color-accent-primary);
    transition: width var(--transition-base);
  }

  .nav__link:hover,
  .nav__link:global(.active) {
    color: var(--color-accent-primary);
  }

  .nav__link:hover::after,
  .nav__link:global(.active)::after {
    width: 100%;
  }

  .nav__divider {
    width: 1px;
    height: 16px;
    background: var(--color-border);
    margin: 0 var(--space-1);
    opacity: 0.5;
  }

  .nav__link--icon {
    display: flex;
    align-items: center;
    padding: var(--space-1);
  }

  .nav__link--icon::after {
    display: none;
  }

  .nav__link--icon svg {
    width: 16px;
    height: 16px;
    transition: transform var(--transition-base);
  }

  .nav__link--icon:hover svg {
    transform: scale(1.1);
  }

  /* Dropdown styles */
  .nav__dropdown {
    position: relative;
  }

  .nav__dropdown-icon {
    margin-left: 4px;
    transition: transform var(--transition-base);
  }

  .nav__dropdown:hover .nav__dropdown-icon {
    transform: rotate(180deg);
  }

  .nav__dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    box-shadow: 0 4px 8px var(--color-shadow);
    list-style: none;
    margin: var(--space-2) 0 0 0;
    padding: var(--space-2) 0;
    min-width: 160px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition: all var(--transition-base);
    z-index: var(--z-dropdown);
  }

  .nav__dropdown:hover .nav__dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .nav__dropdown-link {
    display: block;
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    letter-spacing: var(--tracking-wide);
    padding: var(--space-2) var(--space-4);
    transition: all var(--transition-base);
    white-space: nowrap;
  }

  .nav__dropdown-link:hover {
    color: var(--color-accent-primary);
    background: var(--color-bg-primary);
  }

  /* Mobile toggle button */
  .nav__mobile-toggle {
    display: none;
    flex-direction: column;
    gap: 4px;
    background: none;
    border: none;
    padding: var(--space-2);
    cursor: pointer;
  }

  .nav__mobile-toggle-line {
    width: 20px;
    height: 2px;
    background: var(--color-text-secondary);
    transition: all var(--transition-base);
  }

  /* Mobile menu */
  .nav__mobile-menu {
    display: none;
    background: var(--color-bg-secondary);
    border-top: 1px solid var(--color-border);
    padding: var(--space-4) 0;
  }

  .nav__mobile-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav__mobile-link {
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: var(--text-base);
    font-family: var(--font-mono);
    letter-spacing: var(--tracking-wide);
    padding: var(--space-3) 0;
    border-bottom: 1px solid transparent;
    transition: all var(--transition-base);
  }

  .nav__mobile-link:hover,
  .nav__mobile-link:global(.active) {
    color: var(--color-accent-primary);
    border-bottom-color: var(--color-accent-primary);
  }

  .nav__mobile-link--sub {
    padding-left: var(--space-4);
    font-size: var(--text-sm);
    opacity: 0.8;
  }

  .nav__mobile-link--sub::before {
    content: '→ ';
    margin-right: var(--space-2);
    color: var(--color-accent-secondary);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .nav {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .nav__links {
      display: none;
    }

    .nav__logo-group {
      gap: var(--space-2);
    }

    .nav__mobile-toggle {
      display: flex;
    }

    /* Mobile menu will be controlled by JavaScript */
  }

  /* Mobile toggle animation */
  @media (max-width: 768px) {
    .nav__mobile-toggle[aria-expanded="true"] .nav__mobile-toggle-line:nth-child(1) {
      transform: rotate(45deg) translate(5px, 5px);
    }

    .nav__mobile-toggle[aria-expanded="true"] .nav__mobile-toggle-line:nth-child(2) {
      opacity: 0;
    }

    .nav__mobile-toggle[aria-expanded="true"] .nav__mobile-toggle-line:nth-child(3) {
      transform: rotate(-45deg) translate(7px, -6px);
    }
  }
</style>

